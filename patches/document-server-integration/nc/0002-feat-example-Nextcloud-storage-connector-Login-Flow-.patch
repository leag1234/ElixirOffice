+// Nextcloud storage for the ElixirOffice start page (any Nextcloud server,
+// e.g. Murena Workspace at murena.io).
+//
+// - Login: Nextcloud Login Flow v2. The user signs in on the Nextcloud side
+//   in a browser window; this server polls Nextcloud and receives an app
+//   password, never the user's main password. "Disconnect" deletes the app
+//   password on the Nextcloud server (OCS core/apppassword) and here.
+// - The app password stays on this server, in the encrypted session store
+//   (elixirSession.js); the browser only has an opaque session cookie.
+// - Files: WebDAV (PROPFIND to browse, SEARCH for recent files, GET, PUT).
+//   The document server downloads a file through /elixir/nc/download and
+//   reports saves to /elixir/nc/track; both URLs carry a short signed token,
+//   no credential. Saves go back with If-Match on the ETag; when the file was
+//   changed elsewhere meanwhile, the edit is saved next to it as
+//   "name (conflict).ext" and the user is told on the start page.
+// - Network: only the Nextcloud server the user typed is contacted (https
+//   only unless elixir.nextcloud.allowHttp), optionally restricted to
+//   elixir.nextcloud.allowedServers.
+
+const crypto = require('crypto');
+const path = require('path');
+const fileSystem = require('fs');
+const { Readable } = require('stream');
+const express = require('express');
+const config = require('config');
+const jwt = require('jsonwebtoken');
+const formidable = require('formidable');
+const { XMLParser } = require('fast-xml-parser');
+const DocManager = require('./docManager');
+const fileUtility = require('./fileUtility');
+const session = require('./elixirSession');
+const identityLib = require('./elixirIdentity');
+
+const configServer = config.get('server');
+const ncConfig = (session.elixirConfig && session.elixirConfig.nextcloud) || {};
+const allowHttp = ncConfig.allowHttp === true || process.env.ELIXIR_NC_ALLOW_HTTP === '1';
+const allowedServers = (ncConfig.allowedServers || []).map((s) => String(s).replace(/\/+$/, '').toLowerCase());
+const defaultServer = ncConfig.defaultServer || 'https://murena.io';
+const PRODUCT = (configServer.has('appName') && configServer.get('appName')) || 'ElixirOffice';
+const TIMEOUT = 30000;
+const LOGIN_TTL = 20 * 60 * 1000;
+const TOKEN_TTL = 7 * 24 * 3600;
+
+const cfgSignatureEnable = configServer.get('token.enable');
+const cfgSignatureUseForRequest = configServer.get('token.useforrequest');
+const cfgSignatureAuthorizationHeader = configServer.get('token.authorizationHeader');
+const cfgSignatureAuthorizationHeaderPrefix = configServer.get('token.authorizationHeaderPrefix');
+const cfgSignatureSecret = configServer.get('token.secret');
+
+const home = require('./elixirHome');
+
+home.nextcloudDefaults.defaultServer = defaultServer;
+home.nextcloudDefaults.allowHttp = allowHttp;
+const homeLib = () => home;
+let renderEditor = null; // set by app.js: (req, res, doc) => renders views/editor
+
+// ---------------------------------------------------------------- helpers
+
+class NcError extends Error {
+  constructor(code, message, status) {
+    super(message || code);
+    this.code = code;
+    this.status = status || 0;
+  }
+}
+
+// "murena.io", "https://cloud.example.org/nextcloud/index.php/apps/files" -> base URL
+const normalizeServer = (input) => {
+  let s = String(input || '').trim();
+  if (!s) throw new NcError('badServer');
+  if (!/^[a-z][a-z0-9+.-]*:\/\//i.test(s)) s = `https://${s}`;
+  let u;
+  try {
+    u = new URL(s);
+  } catch (e) {
+    throw new NcError('badServer');
+  }
+  if (u.username || u.password || u.search || u.hash) throw new NcError('badServer');
+  if (u.protocol !== 'https:' && !(u.protocol === 'http:' && allowHttp)) throw new NcError('httpsRequired');
+  let p = u.pathname.replace(/\/(index\.php|apps|login|remote\.php|ocs)(\/.*)?$/, '').replace(/\/+$/, '');
+  if (p === '/') p = '';
+  const base = `${u.protocol}//${u.host}${p}`;
+  if (allowedServers.length && allowedServers.indexOf(base.toLowerCase()) < 0) throw new NcError('serverNotAllowed');
+  return base;
+};
+
+const sameOrigin = (a, b) => {
+  try {
+    return new URL(a).origin === new URL(b).origin;
+  } catch (e) {
+    return false;
+  }
+};
+
+const basicAuth = (nc) => `Basic ${Buffer.from(`${nc.loginName}:${nc.appPassword}`).toString('base64')}`;
+
+const ncFetch = (nc, url, opts = {}) => fetch(url, {
+  method: opts.method || 'GET',
+  headers: {
+    Authorization: basicAuth(nc),
+    'User-Agent': PRODUCT,
+    ...(opts.headers || {}),
+  },
+  body: opts.body,
+  redirect: 'manual',
+  signal: AbortSignal.timeout(opts.timeout || TIMEOUT),
+});
+
+// "/Documents/a b.docx" -> "/Documents/a%20b.docx"; rejects traversal
+const cleanPath = (p) => {
+  const s = String(p || '/');
+  if (s.indexOf('\0') >= 0 || s[0] !== '/') throw new NcError('badPath');
+  const parts = s.split('/').filter(Boolean);
+  if (parts.some((x) => x === '..' || x === '.')) throw new NcError('badPath');
+  return `/${parts.join('/')}`;
+};
+const encodePath = (p) => cleanPath(p).split('/').map(encodeURIComponent).join('/');
+const davBase = (nc) => `${nc.server}/remote.php/dav/files/${encodeURIComponent(nc.userId)}`;
+const davUrl = (nc, p) => davBase(nc) + encodePath(p);
+const parentOf = (p) => {
+  const c = cleanPath(p);
+  const i = c.lastIndexOf('/');
+  return i <= 0 ? '/' : c.slice(0, i);
+};
+const baseName = (p) => cleanPath(p).split('/').pop() || '';
+
+const PROPS = '<d:prop><d:displayname/><d:getlastmodified/><d:getcontentlength/><d:getcontenttype/>'
+  + '<d:getetag/><d:resourcetype/><oc:fileid/><oc:permissions/><oc:size/></d:prop>';
+const NS = 'xmlns:d="DAV:" xmlns:oc="http://owncloud.org/ns" xmlns:nc="http://nextcloud.org/ns"';
+
+const parser = new XMLParser({
+  removeNSPrefix: true,
+  ignoreAttributes: true,
+  parseTagValue: false,
+  processEntities: true,
+  isArray: (name) => name === 'response' || name === 'propstat',
+});
+
+const supportedExts = () => fileUtility.getSuppotredExtensions();
+
+// multistatus -> [{ path, name, type, ... }]
+const parseMultistatus = (nc, xml) => {
+  const doc = parser.parse(xml);
+  const ms = doc && doc.multistatus;
+  const responses = (ms && ms.response) || [];
+  const prefix = `${new URL(nc.server).pathname.replace(/\/+$/, '')}/remote.php/dav/files/${nc.userId}`;
+  return responses.map((r) => {
+    let href = String(r.href || '');
+    try { href = decodeURIComponent(href); } catch (e) { /* keep raw */ }
+    if (/^https?:\/\//.test(href)) href = new URL(href).pathname;
+    let rel = href.indexOf(prefix) === 0 ? href.slice(prefix.length) : null;
+    if (rel === null) return null;
+    rel = rel.replace(/\/+$/, '') || '/';
+    const ok = (r.propstat || []).find((ps) => /\s200\s/.test(String(ps.status || ''))) || (r.propstat || [])[0];
+    const prop = (ok && ok.prop) || {};
+    const isDir = prop.resourcetype && typeof prop.resourcetype === 'object' && 'collection' in prop.resourcetype;
+    const name = rel === '/' ? '' : rel.split('/').pop();
+    const ext = isDir ? '' : fileUtility.getFileExtension(name, true);
+    const perms = String(prop.permissions || '');
+    return {
+      path: rel,
+      name,
+      type: isDir ? 'dir' : 'file',
+      ext,
+      documentType: isDir ? null : fileUtility.getFileType(name) || null,
+      supported: !isDir && supportedExts().indexOf(ext) >= 0,
+      size: Number(isDir ? prop.size : prop.getcontentlength) || 0,
+      time: prop.getlastmodified ? Date.parse(prop.getlastmodified) || 0 : 0,
+      etag: String(prop.getetag || ''),
+      fileid: String(prop.fileid || ''),
+      canWrite: perms.indexOf('W') >= 0 || (isDir && perms.indexOf('C') >= 0),
+      canCreate: perms.indexOf('C') >= 0 || perms.indexOf('K') >= 0,
+    };
+  }).filter(Boolean);
+};
+
+const checkStatus = (r, what) => {
+  if (r.status === 401) throw new NcError('unauthorized', `${what}: 401`, 401);
+  if (r.status === 404) throw new NcError('notFound', `${what}: 404`, 404);
+  if (r.status === 507) throw new NcError('quota', `${what}: 507`, 507);
+  if (r.status >= 300) throw new NcError('serverError', `${what}: ${r.status}`, r.status);
+};
+
+const propfind = async (nc, p, depth) => {
+  const r = await ncFetch(nc, davUrl(nc, p), {
+    method: 'PROPFIND',
+    headers: { Depth: String(depth), 'Content-Type': 'application/xml; charset=utf-8' },
+    body: `<?xml version="1.0"?><d:propfind ${NS}>${PROPS}</d:propfind>`,
+  });
+  checkStatus(r, 'PROPFIND');
+  return parseMultistatus(nc, await r.text());
+};
+
+const stat = async (nc, p) => {
+  const list = await propfind(nc, p, 0);
+  if (!list.length) throw new NcError('notFound');
+  return list[0];
+};
+
+// exact types: Nextcloud's search only accepts "type/subtype" or "type/%"
+const OFFICE_MIMES = [
+  'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
+  'application/vnd.openxmlformats-officedocument.wordprocessingml.template',
+  'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
+  'application/vnd.openxmlformats-officedocument.spreadsheetml.template',
+  'application/vnd.openxmlformats-officedocument.presentationml.presentation',
+  'application/vnd.openxmlformats-officedocument.presentationml.template',
+  'application/vnd.openxmlformats-officedocument.presentationml.slideshow',
+  'application/vnd.ms-word.document.macroEnabled.12',
+  'application/vnd.ms-excel.sheet.macroEnabled.12',
+  'application/vnd.ms-powerpoint.presentation.macroEnabled.12',
+  'application/vnd.oasis.opendocument.text',
+  'application/vnd.oasis.opendocument.spreadsheet',
+  'application/vnd.oasis.opendocument.presentation',
+  'application/msword', 'application/vnd.ms-excel', 'application/vnd.ms-powerpoint',
+  'application/pdf', 'text/csv', 'application/rtf', 'text/rtf',
+];
+
+const recent = async (nc, limit) => {
+  const like = OFFICE_MIMES.map((m) => `<d:eq><d:prop><d:getcontenttype/></d:prop><d:literal>${m}</d:literal></d:eq>`).join('');
+  const body = `<?xml version="1.0" encoding="UTF-8"?><d:searchrequest ${NS}><d:basicsearch>`
+    + `<d:select>${PROPS}</d:select>`
+    + `<d:from><d:scope><d:href>/files/${encodeURIComponent(nc.userId)}</d:href><d:depth>infinity</d:depth></d:scope></d:from>`
+    + `<d:where><d:or>${like}</d:or></d:where>`
+    + '<d:orderby><d:order><d:prop><d:getlastmodified/></d:prop><d:descending/></d:order></d:orderby>'
+    + `<d:limit><d:nresults>${limit}</d:nresults></d:limit>`
+    + '</d:basicsearch></d:searchrequest>';
+  const r = await ncFetch(nc, `${nc.server}/remote.php/dav/`, {
+    method: 'SEARCH',
+    headers: { 'Content-Type': 'text/xml; charset=utf-8' },
+    body,
+  });
+  checkStatus(r, 'SEARCH');
+  return parseMultistatus(nc, await r.text()).filter((f) => f.type === 'file' && f.supported);
+};
+
+const etagOf = (r) => r.headers.get('oc-etag') || r.headers.get('etag') || '';
+
+// PUT; ifMatch: ETag the file must still have; create: fail if it exists
+const put = async (nc, p, data, opts = {}) => {
+  const headers = { 'Content-Type': 'application/octet-stream' };
+  if (opts.ifMatch) headers['If-Match'] = opts.ifMatch;
+  if (opts.create) headers['If-None-Match'] = '*';
+  let r;
+  for (let attempt = 0; ; attempt++) {
+    r = await ncFetch(nc, davUrl(nc, p), { method: 'PUT', headers, body: data, timeout: 120000 }); // eslint-disable-line no-await-in-loop
+    // 423: the file is locked for a moment (another save, a sync client): retry
+    if (r.status !== 423 || attempt >= 5) break;
+    await new Promise((resolve) => { setTimeout(resolve, 1000 * (attempt + 1)); }); // eslint-disable-line no-await-in-loop
+  }
+  if (r.status === 412) return { conflict: true };
+  checkStatus(r, 'PUT');
+  return { etag: etagOf(r) };
+};
+
+// PUT to a free name in the folder: "name.ext", "name (2).ext", …
+const putNew = async (nc, folder, name, data, suffix) => {
+  const ext = fileUtility.getFileExtension(name);
+  const stem = name.slice(0, name.length - ext.length);
+  for (let i = 1; i < 50; i++) {
+    let candidate;
+    if (suffix) candidate = `${stem} (${suffix}${i > 1 ? ` ${i}` : ''})${ext}`;
+    else candidate = i === 1 ? name : `${stem} (${i})${ext}`;
+    const p = `${folder === '/' ? '' : folder}/${candidate}`;
+    const res = await put(nc, p, data, { create: true }); // eslint-disable-line no-await-in-loop
+    if (!res.conflict) return { path: p, name: candidate, etag: res.etag };
+  }
+  throw new NcError('serverError', 'no free name');
+};
+
+const safeName = (name) => String(name || '').replace(/[\\/:*?"<>|\0]/g, '_').trim().slice(0, 200);
+
+// ---------------------------------------------------------------- sessions
+
+const connection = (req) => {
+  const nc = req.elixir.data().nc;
+  return nc && nc.appPassword ? nc : null;
+};
+
+const requireConnection = (req) => {
+  const nc = connection(req);
+  if (!nc) throw new NcError('notConnected', 'not connected', 401);
+  return nc;
+};
+
+const addNotice = (hash, notice) => session.update(hash, (data) => {
+  data.notices = (data.notices || []).concat([{ ...notice, at: Date.now() }]).slice(-20);
+});
+
+// state of Nextcloud files open in the document server, per server+fileid:
+// { key, etag, path per session, sessions } (shared by co-editors)
+const STATE = 'nc-open';
+const fileRef = (nc, fileid) => crypto.createHash('sha256').update(`${nc.server}\n${fileid}`).digest('hex');
+const pruneState = (st) => {
+  const limit = Date.now() - 14 * 24 * 3600 * 1000;
+  Object.keys(st).forEach((k) => { if (!st[k].updated || st[k].updated < limit) delete st[k]; });
+  return st;
+};
+
+// key of the editing session of this file: reused while the file is open,
+// new when the file changed on the Nextcloud side since our last save
+const documentKey = (nc, item, sessionHash) => {
+  const st = pruneState(session.loadState(STATE));
+  const ref = fileRef(nc, item.fileid);
+  let entry = st[ref];
+  if (!entry || entry.etag !== item.etag) {
+    const key = `nc${crypto.createHash('sha256').update(`${ref}\n${item.etag}`).digest('hex').slice(0, 32)}`;
+    entry = { key, etag: item.etag, sessions: {}, server: nc.server, fileid: item.fileid };
+  }
+  entry.sessions[sessionHash] = item.path;
+  entry.updated = Date.now();
+  st[ref] = entry;
+  session.saveState(STATE, st);
+  return { key: entry.key, ref };
+};
+
+// ---------------------------------------------------------------- document server side
+
+const checkDocumentServerJwt = (req) => {
+  if (!(cfgSignatureEnable && cfgSignatureUseForRequest)) return { ok: true, body: req.body };
+  let token = req.body && req.body.token;
+  let fromHeader = false;
+  if (!token) {
+    const auth = req.get(cfgSignatureAuthorizationHeader);
+    if (auth && auth.startsWith(cfgSignatureAuthorizationHeaderPrefix)) {
+      token = auth.substring(cfgSignatureAuthorizationHeaderPrefix.length);
+      fromHeader = true;
+    }
+  }
+  if (!token) return { ok: false };
+  try {
+    const decoded = jwt.verify(token, cfgSignatureSecret);
+    return { ok: true, body: fromHeader && decoded.payload ? decoded.payload : decoded };
+  } catch (e) {
+    return { ok: false };
+  }
+};
+
+// The document server builds the URL of the saved file from the browser's address of the
+// server (e.g. http://localhost:8190/cache/...), which this app may not reach. When the
+// document server is served next to this app (relative server.siteUrl, the packaged
+// setup), fetch it from the internal address instead (elixir.documentServerInternalUrl,
+// default http://localhost/). The URL comes in a callback signed with the JWT secret.
+const siteUrl = configServer.get('siteUrl');
+const dsInternal = (session.elixirConfig && session.elixirConfig.documentServerInternalUrl)
+  || (/^https?:\/\//.test(siteUrl) ? null : 'http://localhost/');
+const internalDocumentServerUrl = (url) => {
+  if (!dsInternal) return url;
+  try {
+    const u = new URL(url);
+    return new URL(u.pathname + u.search, dsInternal).toString();
+  } catch (e) {
+    return url;
+  }
+};
+
+// save what the document server sends back into Nextcloud
+const saveBack = async (tok, body) => {
+  const st = session.loadState(STATE);
+  const entry = st[tok.r];
+  const downloadUrl = body.url;
+  if (!downloadUrl) throw new NcError('serverError', 'no url');
+  const dl = await fetch(internalDocumentServerUrl(downloadUrl), { signal: AbortSignal.timeout(120000) });
+  if (dl.status !== 200) throw new NcError('serverError', `document server download: ${dl.status}`);
+  const data = Buffer.from(await dl.arrayBuffer());
+
+  // any connected session that has this file open can write it back
+  const candidates = [tok.s].concat(entry ? Object.keys(entry.sessions) : []).filter((v, i, a) => a.indexOf(v) === i);
+  let nc = null;
+  let filePath = null;
+  let sessionHash = null;
+  candidates.some((h) => {
+    const s = session.load(h);
+    if (s.nc && s.nc.appPassword && (!entry || s.nc.server === entry.server)) {
+      nc = s.nc;
+      sessionHash = h;
+      filePath = (entry && entry.sessions[h]) || (h === tok.s ? tok.p : null);
+      return !!filePath;
+    }
+    return false;
+  });
+  if (!nc || !filePath) throw new NcError('notConnected', 'no connected session for this file');
+
+  const ext = fileUtility.getFileExtension(filePath, true);
+  const outExt = String(body.filetype || body.fileType || ext).toLowerCase();
+  const sessionsToTell = entry ? Object.keys(entry.sessions) : [sessionHash];
+  let result;
+  if (outExt !== ext) {
+    // saved in another format (e.g. a converted file): keep the original, add a sibling
+    const name = `${baseName(filePath).slice(0, -(ext.length + 1))}.${outExt}`;
+    result = await putNew(nc, parentOf(filePath), name, data);
+  } else {
+    const res = await put(nc, filePath, data, { ifMatch: entry ? entry.etag : tok.e });
+    if (res.conflict) {
+      // changed on the Nextcloud side meanwhile: keep both versions
+      result = await putNew(nc, parentOf(filePath), baseName(filePath), data, 'conflict');
+      await Promise.all(sessionsToTell.map((h) => addNotice(h, {
+        type: 'conflict', name: baseName(filePath), copy: result.name, path: result.path,
+      })));
+    } else {
+      result = { path: filePath, etag: res.etag };
+    }
+  }
+
+  // the editing session now follows the saved file (or its conflict copy)
+  const st2 = session.loadState(STATE);
+  const e2 = st2[tok.r];
+  if (e2) {
+    if (result.path !== filePath) Object.keys(e2.sessions).forEach((h) => { e2.sessions[h] = result.path; });
+    e2.etag = result.etag || e2.etag;
+    e2.updated = Date.now();
+    session.saveState(STATE, st2);
+  }
+  return result;
+};
+
+const closeEntry = (ref) => {
+  const st = session.loadState(STATE);
+  if (st[ref]) {
+    delete st[ref];
+    session.saveState(STATE, st);
+  }
+};
+
+// ---------------------------------------------------------------- editor
+
+const ncEditorDoc = async (req, nc, p) => {
+  const item = await stat(nc, p);
+  if (item.type !== 'file') throw new NcError('notFound');
+  const docManager = new DocManager(req, null);
+  const dsBase = docManager.getServerUrl(true);
+  const { key, ref } = documentKey(nc, item, req.elixir.hash);
+  const tok = { s: req.elixir.hash, p: item.path, r: ref, e: item.etag };
+  let folder = parentOf(item.path);
+  let host = nc.server;
+  try { host = new URL(nc.server).host; } catch (e) { /* keep */ }
+  folder = folder === '/' ? host : `${host}${folder}`;
+  let recentFiles = [];
+  try {
+    recentFiles = (await recent(nc, 30)).filter((f) => f.fileid !== item.fileid);
+  } catch (e) {
+    recentFiles = [];
+  }
+  const server = docManager.getServerUrl();
+  const csrf = req.elixir.csrf();
+  return {
+    title: item.name,
+    key,
+    url: `${dsBase}/elixir/nc/download?t=${session.signToken(tok, TOKEN_TTL)}`,
+    callbackUrl: `${dsBase}/elixir/nc/track?t=${session.signToken(tok, TOKEN_TTL)}`,
+    canWrite: item.canWrite,
+    forcesave: true,
+    recent: recentFiles.map((f) => ({
+      title: f.name,
+      url: `${server}/elixir/nc/open?path=${encodeURIComponent(f.path)}`,
+      folder: parentOf(f.path) === '/' ? host : `${host}${parentOf(f.path)}`,
+      modified: new Date(f.time).toISOString(),
+      size: f.size,
+    })),
+    elixir: {
+      folder,
