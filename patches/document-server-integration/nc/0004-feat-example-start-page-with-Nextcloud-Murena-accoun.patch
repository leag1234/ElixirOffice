+.acct-group-title { padding: 6px 10px 2px; font-size: 12px; font-weight: 600; color: var(--text-2); }
+.acct-test .ic-sm { visibility: hidden; }
+.acct-test[aria-pressed="true"] .ic-sm { visibility: visible; color: var(--accent); }
+.acct-privacy { display: flex; gap: 6px; margin: 8px 8px 2px; padding-top: 10px; border-top: 1px solid var(--border); font-size: 12px; line-height: 16px; color: var(--text-2); }
+.acct-privacy .ic-xs { margin-top: 0; }
+
+/* ---------- connect card, dialogs ---------- */
+.connect-card {
+  display: flex; align-items: center; gap: 20px; margin-bottom: 28px; padding: 18px 20px;
+  background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--accent); border-radius: 8px;
+}
+.connect-icon { width: 36px; height: 36px; color: var(--accent); flex: none; }
+.connect-text { flex: 1; min-width: 0; }
+.connect-text h2 { margin: 0 0 2px; font-size: 16px; line-height: 22px; }
+.connect-text p { margin: 0; color: var(--text-2); }
+.field-label { display: block; margin: 0 0 6px; font-weight: 600; }
+.field {
+  width: 100%; height: 34px; padding: 0 10px; border: 1px solid var(--border-strong); border-radius: 4px; background: var(--surface);
+}
+.field:focus { outline: 2px solid var(--accent); outline-offset: -1px; border-color: var(--accent); }
+.dialog p.field-hint { margin: 8px 0 20px; font-size: 12px; line-height: 16px; }
+.dialog p.field-error { margin: -8px 0 16px; color: var(--danger); }
+.dialog form > p { margin-bottom: 16px; }
+.dialog .field + .dialog-actions { margin-top: 24px; }
+.connect-wait { display: flex; align-items: center; gap: 10px; }
+.spinner { width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--border); border-top-color: var(--accent); animation: spin .8s linear infinite; flex: none; }
+
+/* ---------- Nextcloud folder ---------- */
+.crumbs { display: flex; align-items: center; flex-wrap: wrap; gap: 2px; font-size: 20px; line-height: 28px; font-weight: 600; min-width: 0; }
+.crumb { padding: 2px 6px; border: 0; border-radius: 4px; background: transparent; font: inherit; color: var(--text-2); cursor: pointer; }
+.crumb:hover { background: var(--hover); color: var(--text); }
+span.crumb { color: var(--text); cursor: default; }
+.crumb-sep { width: 16px; height: 16px; color: var(--text-3); }
+.t-folder { color: #c49a1b; }
+.file-where { display: block; font-size: 12px; line-height: 14px; color: var(--text-3); overflow: hidden; text-overflow: ellipsis; }
+.files td.c-name { line-height: 18px; }
+.files tr.unsupported .file-link { color: var(--text-2); }
+.rail-label-clip { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
 
 /* ---------- layout ---------- */
 .layout { display: grid; grid-template-columns: var(--rail-w) minmax(0, 1fr); min-height: calc(100vh - var(--topbar-h)); }
