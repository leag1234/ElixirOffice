index 8bde402c..ea13f876 100644
--- a/web/documentserver-example/nodejs/views/home.ejs
+++ b/web/documentserver-example/nodejs/views/home.ejs
@@ -210,6 +210,7 @@
         uploadExts,
         convertExts,
         maxFileSize,
+        apiUrl,
         startTitles: {
             home: t('home.startNew'),
             new: t('new.title'),
