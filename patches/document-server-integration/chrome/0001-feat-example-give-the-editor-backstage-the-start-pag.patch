 .../nodejs/helpers/elixirHome.js              | 44 +++++++++++++++++++
 .../nodejs/public/elixir/i18n/en.json         |  3 +-
 .../nodejs/public/elixir/i18n/fr.json         |  3 +-
 .../nodejs/views/config.ejs                   |  2 +
 5 files changed, 56 insertions(+), 3 deletions(-)

