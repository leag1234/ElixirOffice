 tests/word/js-api/api-track-revisions.js | 127 +++++++++++++++++++++++
 tests/word/js-api/js-api.html            |   1 +
 word/apiBuilder.js                       |  22 ++--
 3 files changed, 144 insertions(+), 6 deletions(-)
 create mode 100644 tests/word/js-api/api-track-revisions.js

