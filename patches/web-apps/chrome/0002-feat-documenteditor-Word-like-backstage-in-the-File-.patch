+        background: none;
+    }
+
+    .elx-page {
+        overflow: hidden;
+        height: 100%;
+        position: relative;
+        color: var(--text-normal);
+        font-size: 13px;
+    }
+
+    .elx-page-inner {
+        max-width: 1120px;
+        padding: 0 8px 48px 0;
+    }
+
+    .elx-page h1.header {
