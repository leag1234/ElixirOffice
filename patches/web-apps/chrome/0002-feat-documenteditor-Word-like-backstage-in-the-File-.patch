+        }
+        input {
+            width: 100%;
+            height: 32px;
+            padding-left: 34px;
+            font-size: 13px;
+        }
+    }
+
+    // Tiles (Share, Info, Save As)
+    .elx-tiles {
+        display: flex;
+        flex-direction: column;
+        gap: 8px;
+        max-width: 640px;
+        margin-bottom: 8px;
+    }
+
+    .elx-tile {
+        display: flex;
+        align-items: flex-start;
+        gap: 16px;
+        width: 100%;
+        padding: 14px 16px;
+        border: 1px solid var(--border-divider);
+        border-radius: 6px;
+        background: var(--background-normal);
+        color: var(--text-normal);
+        text-align: left;
+        cursor: pointer;
+
+        .elx-tile-icon {
+            display: inline-flex;
+            align-items: center;
+            justify-content: center;
+            width: 40px;
+            height: 40px;
+            flex-shrink: 0;
+            border-radius: 6px;
+            background: var(--background-pane, var(--background-toolbar));
+            color: @elx-accent;
+        }
+        .elx-tile-body {
+            display: flex;
+            flex-direction: column;
+            gap: 4px;
+            flex: 1 1 auto;
+            min-width: 0;
+            padding-top: 1px;
+        }
+        .elx-tile-title { font-size: 14px; font-weight: 600; }
+        .elx-tile-desc { font-size: 12px; line-height: 16px; color: var(--text-secondary); }
+        .elx-tile-chevron { color: var(--icon-normal); padding-top: 10px; }
+
+        &:hover:not([disabled]) { background-color: var(--highlight-button-hover); }
+        &[disabled] {
+            cursor: default;
+            .elx-tile-icon, .elx-tile-title { opacity: .5; }
+        }
+        &:focus { outline: none; }
+        &:focus-visible { box-shadow: 0 0 0 2px @elx-accent; }
+
+        &.elx-tile-big .elx-tile-icon {
+            width: 56px;
+            height: 56px;
+            .elx-icon { width: 28px; height: 28px; }
+        }
+    }
+
+    .elx-people {
+        display: flex;
+        flex-direction: column;
+        gap: 6px;
+        max-width: 640px;
+
+        .elx-person {
+            display: flex;
