+            background: #fff;
+            overflow: hidden;
+            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
+            transition: border-color .1s, box-shadow .1s;
+
+            img {
+                width: 100%;
+                height: 100%;
+                object-fit: cover;
+                object-position: top center;
+            }
+        }
+
+        .elx-thumb-title {
+            display: block;
+            margin-top: 8px;
+            font-size: 12px;
+            line-height: 16px;
+            overflow: hidden;
+            text-overflow: ellipsis;
+            white-space: nowrap;
+        }
+
+        &:hover .elx-thumb-img,
+        &:focus-visible .elx-thumb-img {
+            border-color: @elx-accent;
+            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14);
+        }
+        &:focus { outline: none; }
+    }
+
+    // Recent files
+    .elx-filelist {
