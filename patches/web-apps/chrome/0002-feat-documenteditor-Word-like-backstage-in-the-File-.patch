+// ElixirOffice window chrome (apps/documenteditor/main/app/elixir-chrome):
+// Word-like backstage pages, title bar, navigation pane.
+// Colours come from the theme tokens, so light, dark and RTL follow.
+
+@elx-accent: var(--elixir-accent, var(--border-control-focus));
+
+svg.elx-icon {
+    display: inline-block;
+    flex-shrink: 0;
+    vertical-align: middle;
+    // upstream menus and buttons paint their sprite <svg>s with `fill`; ours follow the text colour
+    fill: currentColor !important;
+}
+
+// ---------------------------------------------------------------------------
+// Backstage pages
+// ---------------------------------------------------------------------------
+#file-menu-panel.elx-backstage {
+    .panel-menu li.fm-btn > a.menu-item .elx-icon.menu-item-icon {
