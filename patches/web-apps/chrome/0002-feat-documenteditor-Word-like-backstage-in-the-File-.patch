+        font-weight: 400;
+        line-height: 36px;
+        margin: 16px 0 20px;
+        padding: 0;
+    }
+
+    .elx-page h2,
+    .elx-section h2 {
+        font-size: 15px;
+        font-weight: 600;
+        line-height: 20px;
+        margin: 24px 0 12px;
+    }
+
+    .elx-section {
+        margin-bottom: 28px;
+    }
+
+    .elx-lead {
+        font-size: 13px;
+        color: var(--text-secondary);
+        margin: -8px 0 16px;
+    }
+
+    .elx-link {
+        display: inline-flex;
+        align-items: center;
+        gap: 2px;
+        margin-top: 12px;
+        padding: 2px 0;
+        border: 0;
+        background: none;
+        color: var(--text-link);
+        font-size: 13px;
+        cursor: pointer;
+
+        &:hover { text-decoration: underline; }
+    }
+
+    .elx-empty {
+        padding: 24px 0;
+        color: var(--text-secondary);
+    }
+
+    // New: template thumbnails
+    .elx-thumbs {
+        display: flex;
+        flex-wrap: wrap;
+        gap: 16px;
+    }
+
+    .elx-thumb {
