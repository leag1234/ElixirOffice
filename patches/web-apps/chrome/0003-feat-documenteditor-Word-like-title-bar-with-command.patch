diff --git a/apps/documenteditor/main/resources/less/elixir-chrome.less b/apps/documenteditor/main/resources/less/elixir-chrome.less
index ad0bb4a06d..28710aa58a 100644
--- a/apps/documenteditor/main/resources/less/elixir-chrome.less
+++ b/apps/documenteditor/main/resources/less/elixir-chrome.less
@@ -547,3 +547,282 @@ svg.elx-icon {
         .d { color: var(--text-secondary); margin-top: 2px; }
     }
 }
+
+// ---------------------------------------------------------------------------
+// Title bar (#box-document-title): file name + save state, centred search
+// ---------------------------------------------------------------------------
+body.elx-chrome {
+    #box-document-title.elx-titlebar {
+        position: relative;
+
+        #id-box-doc-name.elx-docname-box {
+            justify-content: flex-start !important;
+            padding: 0 4px !important;
+            min-width: 0;
+            flex-basis: auto !important;
+        }
+        #title-doc-name { display: none !important; }
+    }
+
+    .elx-docname {
+        display: inline-flex;
+        align-items: center;
+        gap: 6px;
+        max-width: calc(50% - 250px);
+        min-width: 0;
+        height: 28px;
+        padding: 0 6px 0 8px;
+        border: 0;
+        border-radius: 4px;
+        background: transparent;
+        color: var(--text-toolbar-header);
+        font-size: 12px;
+        line-height: 28px;
+        white-space: nowrap;
+        cursor: pointer;
+
+        .elx-docname-text {
+            overflow: hidden;
+            text-overflow: ellipsis;
+            font-weight: 600;
+            min-width: 0;
+        }
+        .elx-docstate {
+            display: inline-flex;
+            align-items: center;
+            gap: 4px;
+            flex-shrink: 0;
+            color: var(--text-secondary);
+            font-weight: 400;
+
