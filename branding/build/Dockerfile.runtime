# Runtime context prepared by tools/image/prepare-runtime.py.
# All generated bytes stay outside Git; EO_ROOT/EO_CONF come from BASE.
ARG BASE=scratch
FROM ${BASE} AS full
# Security updates of the Ubuntu packages published since the base layers were built (for example libbrotli1,
# CVE-2026-111497). Rebuilding this layer is enough to pick up new ones.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get -y upgrade && rm -rf /var/lib/apt/lists/*
COPY sdkjs/common/clientpdf/runtime/ ${EO_ROOT}/sdkjs/common/clientpdf/runtime/
COPY nginx/ /usr/share/elixiroffice-wasm/nginx/
RUN bash /usr/share/elixiroffice-wasm/nginx/configure.sh /usr/share/elixiroffice-wasm/nginx
# Drop-in for deployments written for the ONLYOFFICE image, which mount their data volume at
# /var/www/onlyoffice/Data (Murena Workspace Ansible role): the same directory through a link.
RUN ln -s "${EO_ROOT%/*}" /var/www/onlyoffice
# Identical files (help screenshots repeated in every language, shared fonts) become hard links.
RUN python3 - <<'PY'
import hashlib, os
seen = {}
for root in ('/var/www', '/usr/share/fonts'):
    for directory, _, names in os.walk(root):
        for name in names:
            path = os.path.join(directory, name)
            if os.path.islink(path):
                continue
            info = os.stat(path)
            if info.st_size < 4096:
                continue
            with open(path, 'rb') as handle:
                key = (hashlib.sha256(handle.read()).hexdigest(), info.st_size, info.st_mode, info.st_uid, info.st_gid)
            if key in seen:
                os.unlink(path)
                os.link(seen[key], path)
            else:
                seen[key] = path
PY

# One layer: the install packages copied by the base build, the regenerated font files and the
# upgraded packages no longer leave their earlier copies in lower layers.
FROM scratch
COPY --from=full / /
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    EO_ROOT=/var/www/elixiroffice/documentserver \
    EO_LOG=/var/log/elixiroffice/documentserver \
    EO_CONF=/etc/elixiroffice/documentserver \
    COMPANY_NAME_LOW=elixiroffice \
    PRODUCT_NAME_LOW=documentserver
ARG REVISION=unknown
LABEL org.opencontainers.image.title="ElixirOffice document server" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
ENTRYPOINT ["/entrypoint.sh"]
