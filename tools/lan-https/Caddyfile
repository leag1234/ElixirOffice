{
	# Internal CA only; no public ACME, no HTTP redirect listener, no trust-store install in the container.
	admin off
	local_certs
	auto_https disable_redirects
	skip_install_trust
	# browsers send no SNI for an IP address: serve the certificate of the LAN address then
	default_sni {$HOST}
	servers {
		protocols h1 h2
	}
}

# LAN names/addresses of the test host: set HOST (environment variable, e.g. HOST=office.example.invalid or a .local name); it is also used as default_sni above.
https://{$HOST}:8443, https://localhost:8443 {
	tls internal

	# Root certificate only (never the key): the tester installs it once.
	handle /elixir-ca.crt {
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=\"elixir-ca.crt\""
		root * /data/caddy/pki/authorities/local
		file_server
	}
	handle /elixir-https.html {
		root * /srv/static
		file_server
	}

	# eo dev instance (published on the host port 8080); WebSocket is proxied natively.
	handle {
		reverse_proxy host.docker.internal:8080 {
			header_up X-Forwarded-Proto https
		}
	}
}
