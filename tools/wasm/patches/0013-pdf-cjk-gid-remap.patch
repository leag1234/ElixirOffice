+		try { if (m_bName) m_pRenderer->put_FontName(m_sName); } catch (...) {}
+		try { if (m_bStyle) m_pRenderer->put_FontStyle(m_nStyle); } catch (...) {}
+		try { if (m_bFaceIndex) m_pRenderer->put_FontFaceIndex(m_nFaceIndex); } catch (...) {}
+	}
+
