{
  "app-id": "org.elixiroffice.desktop",
  "branch": "beta",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "base": "org.electronjs.Electron2.BaseApp",
  "base-version": "25.08",
  "command": "elixiroffice-flatpak",
  "separate-locales": false,
  "finish-args": [
    "--socket=x11",
    "--share=ipc",
    "--device=dri",
    "--socket=pulseaudio",
    "--env=GTK_USE_PORTAL=1"
  ],
  "modules": [
    {
      "name": "elixiroffice",
      "buildsystem": "simple",
      "build-commands": [
        "install -d /app/lib/elixiroffice",
        "cp -a payload/. /app/lib/elixiroffice/",
        "install -Dm755 elixiroffice-flatpak /app/bin/elixiroffice-flatpak",
        "install -Dm644 org.elixiroffice.desktop.desktop /app/share/applications/org.elixiroffice.desktop.desktop",
        "install -Dm644 org.elixiroffice.desktop.metainfo.xml /app/share/metainfo/org.elixiroffice.desktop.metainfo.xml",
        "install -Dm644 org.elixiroffice.desktop.png /app/share/icons/hicolor/512x512/apps/org.elixiroffice.desktop.png"
      ],
      "sources": [
        {
          "type": "archive",
          "path": "FINAL-LINUX-PAYLOAD.tar.gz",
          "sha256": "PENDING_FINAL_INPUT_SHA",
          "dest": "payload",
          "strip-components": 0
        },
        {
          "type": "file",
          "path": "elixiroffice-flatpak"
        },
        {
          "type": "file",
          "path": "org.elixiroffice.desktop.desktop"
        },
        {
          "type": "file",
          "path": "org.elixiroffice.desktop.metainfo.xml"
        },
        {
          "type": "file",
          "path": "org.elixiroffice.desktop.png"
        }
      ]
    }
  ]
}
