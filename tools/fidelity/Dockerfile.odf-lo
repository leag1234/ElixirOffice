# LibreOffice headless for the OpenDocument round-trip gate (odf-roundtrip.sh): normalises the generated corpus
# and renders both versions of every document. Reference tool only, NOT a fidelity reference for Word files.
FROM debian:trixie-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libreoffice-writer-nogui libreoffice-calc-nogui libreoffice-impress-nogui libreoffice-draw-nogui libreoffice-math-nogui \
      python3 python3-uno python3-numpy python3-opencv poppler-utils \
      fonts-crosextra-carlito fonts-crosextra-caladea fonts-liberation fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*
ENV HOME=/tmp
WORKDIR /tmp
