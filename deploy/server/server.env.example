# Keep the real server.env outside Git with mode 600. Never print compose config.
# Supply the release tag/digest from its manifest; do not use latest.
EO_IMAGE=
CADDY_IMAGE=
EO_DOMAIN=office.example.org
JWT_SECRET=
# Optional start page: requires trusted network/access control; not authentication.
EO_START_PAGE=false
EO_ALLOW_PRIVATE_STORAGE=false
EO_BIND_ADDRESS=0.0.0.0
EO_HTTP_PORT=80
EO_HTTPS_PORT=443
# Empty means AI off. Do not copy credentials from another deployment.
ELIXIR_AI_BASE_URL=
ELIXIR_AI_MODEL=
ELIXIR_AI_API_KEY=
